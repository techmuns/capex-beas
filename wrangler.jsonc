{
  // Cloudflare Pages configuration for the Capex Guidance Change Monitor.
  //
  // This is a fully static site with NO build step: everything the browser
  // needs already lives in ./public (HTML + committed JSON under public/data).
  // `pages_build_output_dir` tells Cloudflare Pages which folder to serve.
  //
  // One-time setup (see HANDOFF.md → "Cloudflare Pages setup"):
  //   Connect this GitHub repo to Cloudflare Pages once. Leave the build
  //   command EMPTY and set the output directory to `public`. After that,
  //   every push to the default branch — including the automated data
  //   commits made by the GitHub Actions workflows — auto-deploys. No
  //   further manual steps, ever.
  "name": "capex-beas",
  "compatibility_date": "2025-09-16",
  "pages_build_output_dir": "./public",

  // Pages Functions live in ./functions (auto-detected). The email-subscription
  // API (functions/api/*) needs ONE KV namespace bound as `SUBS` for subscriber
  // records. Create it once and bind it, EITHER here (uncomment + paste the id)
  // OR in the Pages dashboard (Settings → Functions → KV namespace bindings →
  // add binding `SUBS`). Until it's bound, the API returns 503 and the dashboard's
  // "Brief" panel shows "not switched on yet" — the dashboard itself is unaffected.
  //
  // "kv_namespaces": [
  //   { "binding": "SUBS", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }
  // ]
}
